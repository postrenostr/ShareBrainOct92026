# Example environment configuration for ShareBrain

# OpenAI API key for GPT models
OPENAI_API_KEY=

# Anthropic key for the existing brain modification service
ANTHROPIC_API_KEY=

# Together API key for hosting Llama models
TOGETHER_API_KEY=

# Google OAuth credentials for user authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe server requests use your own private key via the Stripe SDK.
STRIPE_SECRET_KEY=
# Browser payment forms require the matching Stripe publishable key.
VITE_STRIPE_PUBLIC_KEY=

# Public callback URL registered in the Google OAuth application's settings
GOOGLE_CALLBACK_URL=

# PostgreSQL connection string
DATABASE_URL=

# Secret used to sign Express sessions
SESSION_SECRET=

# Runtime mode: "development" or "production"
NODE_ENV=development

# Replit authentication configuration
REPLIT_DOMAINS=
ISSUER_URL=
REPL_ID=

# GitHub integration for agent version control
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ORGANIZATION=ShareBrain-Developer-Agents


# Dedicated server-to-server key for 10words only (32-256 non-whitespace characters).
# Generate securely and configure the same value on the integrating backend.
TEN_WORDS_API_KEY=
